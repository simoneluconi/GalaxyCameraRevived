# --- Never public: Samsung firmware, stock dumps, per-device data ---
# Stock dumps, official firmware, partition backups (IMEI, MACs, serial),
# boot logs, RAW test shots, the i9300 blob source, Odin packages
/device-dump/
# A stock /system or vendor pulled into the repo root by mistake
/system/
/vendor/
# Firmware and partition images, wherever they land
*.img
*.img.md5
*.tar
*.tar.md5
*.bin
*.lfs
*.pit
RS_M9MO*
modem.bin
sboot.bin
tz.img
# Device identity: getprop/wifi dumps carry the serial and the Wi-Fi MAC
getprop*.txt
wifi.txt
efs/
efs.tar*
nv_data*
# Camera test output (RAW frames carry EXIF and may carry GPS)
*.raw
*.raw.txt
*.dng
# Developer adb keys (they would be baked into builds)
adb_keys
adbkey
adbkey.pub

# --- Private working notes and local settings ---
# The device serials, the Wi-Fi MAC and the local setup (CLAUDE.md imports it)
/CLAUDE.local.md
/.claude/
# This camera's adb serials for tools/flash-adb.sh (one file per model)
/tools/flash-adb.local
/tools/flash-adb-*.local

# --- Build outputs ---
camera-app/**/build/
build/
.gradle/
.kotlin/
.cxx/
.externalNativeBuild/
local.properties
captures/
*.apk
*.aab
*.so
*.o
__pycache__/
*.pyc

# --- Signing keys ---
*.jks
*.keystore
*.p12
*.pem
keystore.properties

# --- IDE and OS ---
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
desktop.ini
