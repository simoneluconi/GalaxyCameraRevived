<!-- Photo full screen; a floating bar on top and the info panel on the right, like the viewfinder's panel column -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.simoneluconi.gcgallery.ui.widget.PhotoPagerView
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="top"
        android:layout_margin="8dp"
        android:background="@drawable/bar_bg"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/back"
            style="@style/BarButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:singleLine="true"
                android:textColor="@color/on_surface_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- The edit actions; held vertically they move to the bottom bar -->
        <LinearLayout
            android:id="@+id/actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- One star; the five open in a small popup -->
            <FrameLayout
                android:id="@+id/rate"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/round_ripple"
                android:contentDescription="@string/rate">

                <ImageView
                    android:id="@+id/rate_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_star" />

                <TextView
                    android:id="@+id/rate_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="1dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/on_accent"
                    android:textSize="9sp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Left, right and flip open in a small popup -->
            <ImageButton
                android:id="@+id/rotate"
                style="@style/BarButton"
                android:contentDescription="@string/rotate"
                android:src="@drawable/ic_rotate_right" />

            <ImageButton
                android:id="@+id/share"
                style="@style/BarButton"
                android:contentDescription="@string/share"
                android:src="@drawable/ic_share" />

            <ImageButton
                android:id="@+id/trash"
                style="@style/BarButton"
                android:contentDescription="@string/trash"
                android:src="@drawable/ic_delete" />
        </LinearLayout>

        <!-- Only while a TV is connected: what it shows and the resolution -->
        <ImageButton
            android:id="@+id/tv"
            style="@style/BarButton"
            android:contentDescription="@string/tv_output"
            android:src="@drawable/ic_tv"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/info"
            style="@style/BarButton"
            android:contentDescription="@string/info"
            android:src="@drawable/ic_info" />
    </LinearLayout>

    <!-- Held vertically: the edit actions, centred at the bottom -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="8dp"
        android:background="@drawable/bar_bg"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone" />

    <!-- Right of the photo, or below it when held vertically; placed in code -->
    <LinearLayout
        android:id="@+id/info_panel"
        android:layout_width="@dimen/info_panel_width"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginStart="8dp"
        android:layout_marginTop="68dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/panel_bg"
        android:elevation="3dp"
        android:orientation="vertical"
        android:visibility="invisible">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbarStyle="outsideOverlay">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <com.simoneluconi.gccommon.ui.HistogramView
                    android:id="@+id/histogram"
                    android:layout_width="match_parent"
                    android:layout_height="76dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/hist_rgb"
                        style="@style/Chip"
                        android:layout_height="30dp"
                        android:text="@string/rgb" />

                    <TextView
                        android:id="@+id/clipping"
                        style="@style/Chip"
                        android:layout_height="30dp"
                        android:text="@string/clipping" />
                </LinearLayout>

                <TextView
                    android:id="@+id/exposure_line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/on_surface"
                    android:textSize="17sp" />

                <LinearLayout
                    android:id="@+id/info_sections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <TextView
        android:id="@+id/zoom_label"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bar_bg"
        android:fontFamily="sans-serif-medium"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/on_surface"
        android:textSize="13sp"
        android:visibility="gone" />

    <include layout="@layout/message_bar" />
</FrameLayout>
