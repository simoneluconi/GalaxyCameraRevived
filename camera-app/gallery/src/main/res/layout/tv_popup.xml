<!-- The TV: what is connected, and the resolution (Auto, then every mode hdmid can drive) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tv_popup"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="@drawable/panel_bg"
    android:elevation="6dp"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/tv_sink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:singleLine="true"
        android:textColor="@color/on_surface"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_mode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:fontFeatureSettings="tnum"
        android:singleLine="true"
        android:textColor="@color/on_surface_muted"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08"
        android:text="@string/tv_resolution"
        android:textAllCaps="true"
        android:textColor="@color/accent"
        android:textSize="11sp" />

    <ScrollView
        android:id="@+id/tv_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:id="@+id/tv_modes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
