<?xml version="1.0" encoding="utf-8"?>
<!-- Wi-Fi transfer: the address and PIN to type on the computer, and on/off -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/panel_bg"
        android:elevation="3dp"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="22dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/on_surface_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/url"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/on_surface"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/ip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/on_surface_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/on_surface_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/password_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/on_surface"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/password"
                style="@style/TextButton"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/password_remove"
                style="@style/TextButton"
                android:layout_height="36dp"
                android:text="@string/transfer_remove_password" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/close"
                style="@style/TextButton"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:text="@string/close" />

            <TextView
                android:id="@+id/toggle"
                style="@style/TextButton"
                android:layout_height="40dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
