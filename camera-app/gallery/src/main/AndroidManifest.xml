<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Without it MediaProvider blanks the GPS tags of photos other apps took -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- Special app-op: trash, edit and favourite GC Camera's photos without a dialog each time -->
    <uses-permission android:name="android.permission.MANAGE_MEDIA" />
    <!-- The Wi-Fi transfer's permissions, service and screens come from the :transfer module's manifest -->

    <application
        android:name=".GalleryApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:largeHeap="true"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.GcGallery">

        <activity
            android:name=".ui.GridActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:launchMode="singleTask"
            android:screenOrientation="fullUser">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_GALLERY" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ViewerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true"
            android:screenOrientation="fullUser"
            android:theme="@style/Theme.GcGallery.Viewer">
            <!-- GC Camera's last-shot button -->
            <intent-filter>
                <action android:name="android.provider.action.REVIEW" />
                <action android:name="android.provider.action.REVIEW_SECURE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.provider.action.REVIEW" />
                <action android:name="android.provider.action.REVIEW_SECURE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
            </intent-filter>
            <!-- Opening a picture from any other app -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- The transfer's tile, under this exact name: gd1-setup.sh adds it to the default tiles -->
        <service
            android:name=".transfer.TransferTile"
            android:exported="true"
            android:icon="@drawable/ic_wifi_transfer"
            android:label="@string/transfer_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
    </application>
</manifest>
