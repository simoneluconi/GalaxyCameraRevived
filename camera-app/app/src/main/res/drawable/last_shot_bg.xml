<?xml version="1.0" encoding="utf-8"?>
<!-- The last-shot thumbnail over the viewfinder: a light frame that reads on any image -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/overlay_line">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/overlay_shadow" />
            <stroke
                android:width="2dp"
                android:color="@color/overlay_line" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</ripple>
