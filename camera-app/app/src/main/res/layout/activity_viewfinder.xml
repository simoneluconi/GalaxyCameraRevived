<?xml version="1.0" encoding="utf-8"?>
<!-- 1280x720 landscape: the 4:3 viewfinder (960x720) on the left, the shooting panel on the right -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="horizontal">

    <com.simoneluconi.gccamera.ui.widget.AspectFrameLayout
        android:id="@+id/viewfinder"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="#FF000000">

        <SurfaceView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/review"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF000000"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <com.simoneluconi.gccamera.ui.widget.ViewfinderOverlayView
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- The viewfinder's bars, laid out in the user's frame: held vertically, this frame
             takes the viewfinder's swapped size and turns, so the status bar stays at the top
             and the zoom at the bottom as the user sees them (ViewfinderActivity.layoutHud) -->
        <FrameLayout
            android:id="@+id/hud"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center">

            <com.simoneluconi.gccamera.ui.widget.StatusBarView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:layout_gravity="top" />

            <com.simoneluconi.gccamera.ui.widget.ZoomBarView
                android:id="@+id/zoom"
                android:layout_width="180dp"
                android:layout_height="34dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp" />

            <!-- Optional (Settings → Display), over the image under the status bar -->
            <com.simoneluconi.gccamera.ui.widget.HistogramView
                android:id="@+id/histogram"
                android:layout_width="120dp"
                android:layout_height="60dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="34dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />

            <!-- The last shot: opens it in the gallery; hidden until there is one -->
            <ImageView
                android:id="@+id/btn_last"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/last_shot_bg"
                android:clipToOutline="true"
                android:contentDescription="@string/last_shot"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- Only while the pop-up flash is raised (closed means off): toggles auto and on -->
            <TextView
                android:id="@+id/btn_flash"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/flash_chip_bg"
                android:drawableStart="@drawable/ic_flash"
                android:drawablePadding="4dp"
                android:drawableTint="@color/overlay_line"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="64dp"
                android:paddingStart="8dp"
                android:paddingEnd="10dp"
                android:textColor="@color/overlay_line"
                android:textSize="13sp"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/quick_menu_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#40000000"
            android:clickable="true"
            android:focusable="false"
            android:visibility="gone">

            <com.simoneluconi.gccamera.ui.widget.QuickMenuView
                android:id="@+id/quick_menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clickable="true" />
        </FrameLayout>
    </com.simoneluconi.gccamera.ui.widget.AspectFrameLayout>

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp">

        <com.simoneluconi.gccamera.ui.widget.ModeSelectorView
            android:id="@+id/mode"
            android:layout_width="match_parent"
            android:layout_height="42dp" />

        <!-- The rows share the height left by the mode selector, the meter and the buttons -->
        <com.simoneluconi.gccamera.ui.widget.ValueRowView
            android:id="@+id/row_shutter"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1" />

        <com.simoneluconi.gccamera.ui.widget.ValueRowView
            android:id="@+id/row_aperture"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1" />

        <com.simoneluconi.gccamera.ui.widget.ValueRowView
            android:id="@+id/row_iso"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1" />

        <!-- Compensation control in P/A/S, exposure meter in M -->
        <com.simoneluconi.gccamera.ui.widget.ExposureMeterView
            android:id="@+id/meter"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp" />

        <!-- RAW is a setting and the flash chip sits on the viewfinder: easy to touch by accident -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btn_fn"
                style="@style/PanelButton">

                <TextView
                    android:id="@+id/label_fn"
                    style="@style/PanelLabel"
                    android:text="@string/fn" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_settings"
                style="@style/PanelButton"
                android:contentDescription="@string/settings_title">

                <ImageView
                    android:id="@+id/label_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_settings" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
